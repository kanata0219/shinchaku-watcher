{"url": "https://www.atelierm.net/catalog", "etag": null, "last_modified": null, "body": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<meta name=\"csrf-token\" content=\"XXvSPFtBPtTqiLh3MDwZXBsO2aKa6Fu8HNMes1ZT\">\n<meta property=\"og:title\" content=\"楽譜一覧 - アトリエ・エム\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"\">\n<meta property=\"og:description\" content=\"アトリエ・エムが出版する吹奏楽譜・アンサンブル譜の一覧。\">\n<meta property=\"og:url\" content=\"https://www.atelierm.net/catalog\">\n<meta property=\"og:image\" content=\"https://test.atelierm.net/media/ogp.jpg\">\n<meta name=\"description\" content=\"アトリエ・エムが出版する吹奏楽譜・アンサンブル譜の一覧。\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n<link rel=\"shortcut icon\" href=\"/favicon.ico\">\n<link rel=\"manifest\" href=\"/site.webmanifest\">\n<script defer src=\"https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js\"></script>\n<link href=\"/css/common.css?202610091040\" rel=\"stylesheet\" type=\"text/css\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,300,0,0&icon_names=home\" />\n<title>楽譜一覧 - アトリエ・エム</title>\n</head>\n\n<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-71PQMV6REK\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-71PQMV6REK');\n</script>\n\n<body>\n<header id=\"header\" class=\"header\">\n<div class=\"header-wrapper\">\n\n<div class=\"p-logo\">\n  <h1><a href=\"/\"><img src=\"/media/logo@1x.png\" srcset=\"/media/logo@1x.png 1x, /media/logo@2x.png 2x\" alto=\"アトリエ・エム\"></a></h1>\n</div><!-- p-logo -->\n<nav id=\"globalmenu\" class=\"p-globalmenu\">\n  <input type=\"checkbox\" id=\"globalmenu-button-check\" name=\"globalmenu-button-check\">\n  <label for=\"globalmenu-button-check\" class=\"globalmenu-button-label\"><span></span></label>\n  <div class=\"globalmenu-list\">\n    <ul>\n      <li \"><a href=\"/\">ホーム</a></li>\n      <li  class=\"current\" \"><a href=\"/catalog\">楽譜一覧</a></li>\n      <li \"><a href=\"/faq\">よくあるご質問</a></li>\n      <li \"><a href=\"/contact\">お問い合わせ</a></li>\n      <li \"><a href=\"/aboutus\">会社概要</a></li>\n    </ul>\n  </div><!-- globalmenu-list -->\n</nav>\n\n</div><!-- header-wrapper -->\n</header>\n\n\n<div class=\"l-content\"><div class=\"l-content-wrapper\">\n  <div class=\"l-catalog l-wrapper-md\">\n    <h1>楽譜一覧</h1>\n\n    <div x-data=\"productsList()\" x-init=\"load()\" class=\"catalog-list u-margin-top-lg\">\n      <div class=\"filters\" x-data=\"{ filtersOpen: false }\">\n\n        <!-- ヘッダー -->\n        <div class=\"filters-header\">\n          <h3>絞り込み</h3>\n\n          <!-- SP用 開閉ボタン -->\n          <button\n            type=\"button\"\n            class=\"filters-toggle\"\n            @click=\"filtersOpen = !filtersOpen\"\n            aria-expanded=\"filtersOpen\"\n          >\n            <span x-text=\"filtersOpen ? '閉じる' : '開く'\"></span>\n          </button>\n        </div>\n\n        <div class=\"filters-body\" :class=\"{ open: filtersOpen }\">\n          <!-- formation -->\n          <fieldset>\n            <legend>編成</legend>\n            <template x-for=\"item in formations\" :key=\"item.value\">\n              <label>\n                <input\n                  type=\"checkbox\"\n                  :value=\"item.value\"\n                  x-model.number=\"activeFormations\"\n                >\n                <span x-text=\"item.name\"></span>\n              </label>\n            </template>\n          </fieldset>\n\n          <!-- genre -->\n          <fieldset>\n            <legend>ジャンル</legend>\n            <template x-for=\"item in genres\" :key=\"item.value\">\n              <label>\n                <input\n                  type=\"checkbox\"\n                  :value=\"item.value\"\n                  x-model.number=\"activeGenres\"\n                >\n                <span x-text=\"item.name\"></span>\n              </label>\n            </template>\n          </fieldset>\n\n          <!-- arranger -->\n          <fieldset>\n            <legend>作・編曲家</legend>\n            <template x-for=\"item in arrangers\" :key=\"item.value\">\n              <label>\n                <input\n                  type=\"checkbox\"\n                  :value=\"item.value\"\n                  x-model=\"activeArrangers\"\n                >\n                <span x-text=\"item.name\"></span>\n              </label>\n            </template>\n          </fieldset>\n\n          <div class=\"filters-actions u-margin-top-md\">\n            <span\n              class=\"filters-link\"\n              role=\"button\"\n              tabindex=\"0\"\n              @click=\"checkAll()\"\n              @keydown.enter=\"checkAll()\"\n            >絞り込みを解除</span>\n          </div>\n        </div>\n\n      </div>\n\n\n      <div class=\"list\">\n        <div class=\"sort-control\">\n          <label>\n            <span class=\"sort-label\">並び替え</span>\n            <select x-model=\"sortKey\">\n              <option value=\"popularity\">人気順</option>\n              <option value=\"furigana\">五十音順</option>\n              <option value=\"updated_at\">新着順</option>\n              <option value=\"price_asc\">価格が安い順</option>\n              <option value=\"price_desc\">価格が高い順</option>\n            </select>\n          </label>\n        </div>\n        <ul class=\"products u-margin-top-md\">\n          <template x-for=\"product in visibleProducts\" :key=\"product.id\">\n            <li><a :href=\"`/catalog/show/${product.code.toLowerCase()}`\">\n              <div class=\"thumbnail\">\n                <div :style=\"`background-image: url('/media/product/thumbnail_${product.code.toLowerCase()}.jpg')`\"></div>\n                <span\n                  class=\"thumbnail-label\"\n                  :class=\"product.formation === 1 ? 'label-wind' : 'label-ensemble'\"\n                  x-text=\"product.formation === 1 ? '吹奏楽譜' : 'アンサンブル譜'\"\n                  x-show=\"product.formation === 1 || product.formation === 2\"\n                ></span>\n\n              </div>\n              <div class=\"description\">\n                <h3 class=\"title\" x-text=\"product.title\"></h3>\n                <p class=\"title_sub\" x-show=\"product.title_sub\" x-text=\"product.title_sub\"></span>\n                <p class=\"price u-margin-top-xs\">¥<span x-text=\"product.price.toLocaleString('en-US')\"></span></p>\n              </div><!-- description -->\n            </a></li>\n          </template>\n        </ul>\n        <!-- Sentinel for lazy loading -->\n        <div x-ref=\"sentinel\" style=\"height: 1px;\"></div>\n      </div><!-- list -->\n    </div><!-- catalog-list -->\n  </div><!-- l-catalog -->\n\n</div></div><!-- content -->\n  \n\n<script>\nfunction productsList() {\n  return {\n    products: [],\n    loading: false,\n\n    /* 並び替え */\n    sortKey: 'popularity',\n\n    /* フィルタ定義（静的） */\n    formations: [\n      { value: 1, name: '吹奏楽譜' },\n      { value: 2, name: 'アンサンブル譜' }\n    ],\n    genres: [\n      { value: 1, name: 'オリジナル作品' },\n      { value: 2, name: 'クラシック' },\n      { value: 3, name: '日本の叙情歌' },\n      { value: 4, name: 'ジャズ・ポップス' }\n    ],\n    arrangers: [\n      { value: '真島 俊夫', name: '真島 俊夫' },\n      { value: '星出 尚志', name: '星出 尚志' },\n      { value: '高橋 徹', name: '高橋 徹' },\n      { value: '天野 正道', name: '天野 正道' },\n      { value: '鈴木 英史', name: '鈴木 英史' },\n      { value: '河邊 一彦', name: '河邊 一彦' }\n    ],\n\n    /* 有効フィルタ */\n    activeFormations: [],\n    activeGenres: [],\n    activeArrangers: [],\n\n    checkAll() {\n      this.activeFormations = this.formations.map(f => f.value);\n      this.activeGenres = this.genres.map(g => g.value);\n      this.activeArrangers = this.arrangers.map(a => a.value);\n    },\n\n    uncheckAll() {\n      this.activeFormations = [];\n      this.activeGenres = [];\n      this.activeArrangers = [];\n    },\n\n\n    /* lazy load */\n    pageSize: 12,        // 1回に増える件数\n    visibleCount: 12,    // 現在表示している件数\n    io: null,            // IntersectionObserver\n\n    async load() {\n      this.loading = true;\n      try {\n        const res = await fetch('/storage/products.json');\n        this.products = await res.json();\n\n        // URL → state\n        this.restoreFromUrl();\n\n        // URL指定が無いものは全ON\n        if (this.activeFormations.length === 0) {\n          this.activeFormations = this.formations.map(f => f.value);\n        }\n        if (this.activeGenres.length === 0) {\n          this.activeGenres = this.genres.map(g => g.value);\n        }\n        if (this.activeArrangers.length === 0) {\n          this.activeArrangers = this.arrangers.map(a => a.value);\n        }\n\n        // 初期表示件数\n        this.visibleCount = this.pageSize;\n\n        // state → URL（監視） + lazy reset\n        this.$watch('activeFormations', () => { this.updateUrl(); this.resetLazy(); });\n        this.$watch('activeGenres', () => { this.updateUrl(); this.resetLazy(); });\n        this.$watch('activeArrangers', () => { this.updateUrl(); this.resetLazy(); });\n\n        // 並び替え変更でも先頭に戻す\n        this.$watch('sortKey', () => { this.resetLazy(); });\n\n      } catch (e) {\n        console.error(e);\n        this.products = [];\n      } finally {\n        this.loading = false;\n      }\n\n      // DOM準備後に監視開始（HTML側に x-ref=\"sentinel\" が必要）\n      this.$nextTick(() => this.setupInfiniteScroll());\n    },\n\n    /* URL → checkbox */\n    restoreFromUrl() {\n      const params = new URLSearchParams(window.location.search);\n\n      if (params.has('formation')) {\n        this.activeFormations = params.get('formation').split(',').map(Number);\n      }\n\n      if (params.has('genre')) {\n        this.activeGenres = params.get('genre').split(',').map(Number);\n      }\n\n      if (params.has('arranger')) {\n        this.activeArrangers = params.get('arranger').split(',');\n      }\n    },\n\n    /* checkbox → URL */\n    updateUrl() {\n      const params = new URLSearchParams();\n\n      if (this.activeFormations.length) params.set('formation', this.activeFormations.join(','));\n      if (this.activeGenres.length) params.set('genre', this.activeGenres.join(','));\n      if (this.activeArrangers.length) params.set('arranger', this.activeArrangers.join(','));\n\n      const newUrl = window.location.pathname + (params.toString() ? `?${params}` : '');\n      history.replaceState(null, '', newUrl);\n    },\n\n    /* フィルタ + 並び替え（全件） */\n    get filteredAndSortedProducts() {\n      return [...this.products]\n        .filter(p =>\n          this.activeFormations.includes(p.formation) &&\n          this.activeGenres.includes(p.genre) &&\n          this.activeArrangers.includes(p.arranger)\n        )\n        .sort((a, b) => {\n          switch (this.sortKey) {\n            case 'popularity':\n              return (b.popularity ?? 0) - (a.popularity ?? 0);\n            case 'price_asc':\n              return a.price - b.price;\n            case 'price_desc':\n              return b.price - a.price;\n            case 'furigana':\n              return a.title_ruby.localeCompare(b.title_ruby, 'ja');\n            case 'updated_at':\n              return new Date(b.updated_at) - new Date(a.updated_at);\n            default:\n              return 0;\n          }\n        });\n    },\n\n    /* 表示対象（lazy） */\n    get visibleProducts() {\n      return this.filteredAndSortedProducts.slice(0, this.visibleCount);\n    },\n\n    get hasMore() {\n      return this.visibleCount < this.filteredAndSortedProducts.length;\n    },\n\n    loadMore() {\n      if (!this.hasMore) return;\n      this.visibleCount = Math.min(\n        this.visibleCount + this.pageSize,\n        this.filteredAndSortedProducts.length\n      );\n    },\n\n    resetLazy() {\n      // フィルタ/ソート変更時は先頭へ\n      this.visibleCount = this.pageSize;\n      this.$nextTick(() => this.setupInfiniteScroll());\n    },\n\n    setupInfiniteScroll() {\n      // 既存があれば切断\n      if (this.io) {\n        this.io.disconnect();\n        this.io = null;\n      }\n\n      // sentinelが無ければ何もしない\n      if (!this.$refs || !this.$refs.sentinel) return;\n\n      this.io = new IntersectionObserver((entries) => {\n        if (entries[0]?.isIntersecting) this.loadMore();\n      }, {\n        root: null,\n        rootMargin: '600px 0px', // ちょい手前で読み込み\n        threshold: 0\n      });\n\n      this.io.observe(this.$refs.sentinel);\n    }\n  }\n}\n</script>\n\n\n\n\n<footer id=\"footer\">\n  <div\n    class=\"pageTop\"\n    x-data=\"{ show:false }\"\n    x-cloak\n    @scroll.window=\"show = window.scrollY > 300\"\n    x-show=\"show\"\n    x-transition.opacity.duration.200ms\n  >\n    <a\n      href=\"#\"\n      aria-label=\"ページの先頭へ戻る\"\n      @click.prevent=\"window.scrollTo({ top: 0, behavior: 'smooth' })\"\n    >\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path\n          d=\"M6 14l6-6 6 6\"\n          fill=\"none\"\n          stroke=\"#e02315\"\n          stroke-width=\"2.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n        />\n      </svg>\n    </a>\n  </div>\n\n  <div class=\"footer-wrapper\">\n    <div class=\"footer-flex\">\n      <div class=\"left\">\n        <div class=\"logo\">\n          <a href=\"/\"><img src=\"/media/logo@1x.png\" srcset=\"/media/logo@1x.png 1x, /media/logo@2x.png 2x\" alto=\"アトリエ・エム\"></a>\n        </div>\n      </div>\n      <div class=\"center\">\n        <ul class=\"categories\">\n          <li>\n            <a href=\"/catalog\">楽譜一覧</a>\n          </li>\n                  <li><a href=\"/faq\">よくあるご質問</a></li>\n          <li><a href=\"/contact\">お問い合わせ</a></li>\n        </ul>\n      </div>\n      <div class=\"right\">\n        <ul class=\"categories\">\n\n          <li><a href=\"/aboutus/salespolicies\">特定商取引の表示</a></li>\n          <li><a href=\"/aboutus/privacy\">プライバシーポリシー</a></li>\n          <li><a href=\"/aboutus\">会社概要</a></li>\n        </ul>\n      </div>\n    </div><!-- footer-flex -->\n\n    <div class=\"copyright u-margin-top-lg\">\n      <p><span>&copy; 2007 - 2026 atelier M Inc. </span><span>All rights reserved.</span></p>\n    </div>\n  </div><!-- footer-wrapper -->\n</footer>\n\n</body>\n</html>\n", "saved_at": 1791510057.6967907}