utton sb_icon_inner\"data-clipboard-text=\"ストーンミュージック https://www.stonemusic.jp/dorico-93/\"><span class=\"vk_icon_w_r_sns_copy icon_sns\"><i class=\"fas fa-copy\"></i></span><span class=\"sns_txt\">Copy</span></button></li></ul></div><!-- [ /.socialSet ] -->]]></content:encoded>\n\t\t\t\t\t\n\t\t\n\t\t<enclosure url=\"https://www.stonemusic.jp/wp-content/uploads/2026/09/c1f6a0b3269d2dc8da8eed76e22185ad.mp4\" length=\"89578\" type=\"video/mp4\" />\n\n\t\t\t</item>\n\t</channel>\n</rss>\n", "saved_at": 1792800663.7756264}